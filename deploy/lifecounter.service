[Unit]
Description=LifeCounter - Gunicorn (lifecounter.mreis.site)
After=network.target

[Service]
User=root
WorkingDirectory=/root/lifecounter/backend
EnvironmentFile=/root/lifecounter/backend/.env
ExecStart=/root/lifecounter/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8013 --timeout 60 config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
